{
  "name": "paperread-cli",
  "version": "1.4.7-cli.3",
  "description": "PaperRead community build with native Antigravity CLI and Codex support",
  "author": {
    "name": "YuriyLin"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:backend": "python scripts/build_backend.py",
    "dist": "npm run build:backend && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.jimmymochi.paperread-cli",
    "productName": "PaperRead CLI",
    "protocols": [
      {
        "schemes": [
          "paperread-cli"
        ],
        "name": "PaperRead CLI"
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets/paperread.ico",
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-PaperRead.txt"
      },
      {
        "from": "分享版說明.md",
        "to": "分享版說明.md"
      },
      {
        "from": "build/third-party-licenses",
        "to": "third-party-licenses"
      }
    ],
    "win": {
      "icon": "electron/assets/paperread.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "electron/assets/paperread.ico",
      "uninstallerIcon": "electron/assets/paperread.ico",
      "artifactName": "PaperRead-CLI-Setup-${version}.exe",
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ],
      "language": "1028",
      "runAfterFinish": false,
      "license": "LICENSE"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
